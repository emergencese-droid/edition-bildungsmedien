    docs = db.query(DocumentRecord).filter(DocumentRecord.source_email_id == email_id).all()
    return {
        "id": rec.id,
        "status": rec.status,
        "intent": rec.intent_tag,
        "generated_documents": [
            {
                "id": d.id, 
                "title": d.title, 
                "path": d.storage_path, 
                "meta": d.metadata_payload
            }
            for d in docs
        ]
    }
