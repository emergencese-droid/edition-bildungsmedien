            source_email_id=rec.id,
            title=f"{rec.intent_tag.upper()}: {rec.subject}",
            doc_type=rec.intent_tag,
            storage_path=doc_path,
            metadata_payload={
                "nlp_analysis": analysis,
                "spatial_metrics": space_metrics
            }
        )
        db.add(doc_entry)
        db.commit()
    finally:
        db.close()

@app.get("/api/health")
def health():
    return {
        "status": "ok",
        "subsystems": {
            "officewrite": "online",
            "space_engine": "online",
            "db": "ready",
            "ai_bridge": "connected"
        }
    }

@app.post("/api/emails/ingest", status_code=202)
def ingest_email(payload: EmailIngestSchema, bg: BackgroundTasks, db: Session = Depends(get_db)):
    record_id = str(uuid.uuid4())
    msg_id = payload.message_id or f"msg-{record_id[:8]}"

    db_email = EmailRecord(
        id=record_id,
        message_id=msg_id,
        sender=payload.sender,
        recipient=payload.recipient,
        subject=payload.subject,
        body_text=payload.body_text,
        status="queued"
    )
    db.add(db_email)
    db.commit()

    bg.add_task(process_email_background, record_id)

    return {
        "status": "accepted",
        "email_id": record_id,
        "message_id": msg_id
    }

