"""
src/space_engine/projector.py
Modul zur 3D-Koordinatentransformation und Projektion des 8er-UVC-Designs.
"""
import math
from pathlib import Path
from typing import List, Tuple, Dict, Any

class SpatialProjector:
    def __init__(self, tilt_deg: float = 33.3, pan_deg: float = 180.0):
        # Konvertierung in Radiant
        self.theta_x = math.radians(tilt_deg)  # Neigung (Tilt)
        self.theta_z = math.radians(pan_deg)   # Vertikale Drehung (Pan)
        
    def rotate_point(self, x: float, y: float, z: float) -> Tuple[float, float, float]:
        """
        Wendet Rotationsmatrizen an:
        1. Drehung um die X-Achse (Tilt um ~33.3°)
        2. Drehung um die Z-Achse (Pan um 180°)
        """
        # Rotation um X-Achse
        x1 = x
        y1 = y * math.cos(self.theta_x) - z * math.sin(self.theta_x)
        z1 = y * math.sin(self.theta_x) + z * math.cos(self.theta_x)
        
        # Rotation um Z-Achse
        x2 = x1 * math.cos(self.theta_z) - y1 * math.sin(self.theta_z)
        y2 = x1 * math.sin(self.theta_z) + y1 * math.cos(self.theta_z)
        z2 = z1
        
        return round(x2, 4), round(y2, 4), round(z2, 4)

    def generate_8_grid(self) -> List[Tuple[float, float, float]]:
        """Erzeugt die Basisknoten für ein doppelschleifiges 8er-Gitter im 3D-Raum."""
        points = []
        steps = 16
        for i in range(steps):
            t = 2 * math.pi * (i / steps)
            # Lemniskate von Bernoulli / 8er-Topologie
            scale = 100.0
            x = (scale * math.cos(t)) / (1 + math.sin(t)**2)
            y = (scale * math.sin(t) * math.cos(t)) / (1 + math.sin(t)**2)
            z = math.sin(2 * t) * 25.0
            points.append((x, y, z))
        return points

    def process_space(self, output_svg_path: Path) -> Dict[str, Any]:
        """Transformiert alle Raumpunkte und erzeugt eine Projektions-Grafik (SVG)."""
        base_points = self.generate_8_grid()
        projected = [self.rotate_point(x, y, z) for x, y, z in base_points]
        
        # SVG Rendern (Orthografische Parallelprojektion auf 2D-Ebene)
        svg_lines = [
            '<svg xmlns="http://www.w3.org/2000/svg" viewBox="-150 -150 300 300" width="400" height="400">',
            '  <rect x="-150" y="-150" width="300" height="300" fill="#0f172a" />',
            '  <!-- Koordinatenachsen -->',
            '  <line x1="-130" y1="0" x2="130" y2="0" stroke="#334155" stroke-dasharray="2" />',
            '  <line x1="0" y1="-130" x2="0" y2="130" stroke="#334155" stroke-dasharray="2" />',
            '  <!-- 8er-Design Projektion (Tilt 33.3°, Pan 180°) -->'
        ]
        
        # Pfad zeichnen
        path_d = []
        for i, (px, py, _) in enumerate(projected):
            cmd = "M" if i == 0 else "L"
            path_d.append(f"{cmd} {px} {py}")
        path_d.append("Z")
        
        svg_lines.append(f'  <path d="{" ".join(path_d)}" fill="none" stroke="#38bdf8" stroke-width="2" />')
        
        # Knotenpunkte einzeichnen
        for px, py, _ in projected:
            svg_lines.append(f'  <circle cx="{px}" cy="{py}" r="3" fill="#f43f5e" />')
            
        svg_lines.append('</svg>')
        
        output_svg_path.parent.mkdir(parents=True, exist_ok=True)
        with open(output_svg_path, "w", encoding="utf-8") as f:
            f.write("\n".join(svg_lines))
            
        return {
            "tilt_applied_deg": 33.3,
            "pan_applied_deg": 180.0,
            "nodes_count": len(projected),
            "projected_sample": projected[:4],
            "vector_path": str(output_svg_path)
        }
3. Anpassung des Background-Workers (src/app/main.py)
Wir integrieren den SpatialProjector direkt in den Hintergrund-Task der FastAPI-Applikation. Bei jedem E-Mail-Ingest wird der Raum berechnet, das Vektordiagramm erzeugt und die Metadaten-Matrix im Dokumenten-Datensatz hinterlegt:

Python
# Ausschnitt aus src/app/main.py

from src.space_engine.projector import SpatialProjector

spatial_projector = SpatialProjector(tilt_deg=33.3, pan_deg=180.0)

def process_email_background(email_id: str):
    from src.db.session import SessionLocal
    db = SessionLocal()
    try:
        rec = db.query(EmailRecord).filter(EmailRecord.id == email_id).first()
        if not rec:
            return

        # 1. Intent Klassifikation
        analysis = extract_intent_and_summary(rec.subject, rec.body_text)
        rec.intent_tag = analysis["intent"]
        rec.status = "processed"

        # 2. Raum-Berechnung und SVG-Generierung
        doc_id = str(uuid.uuid4())
        svg_file = Path("./storage_vault") / f"{doc_id}_uvc8_projection.svg"
        space_metrics = spatial_projector.process_space(svg_file)

        # 3. Erweiterte Dokumentenerstellung via OfficeWrite
        doc_summary = (
            f"{analysis['summary']}\n\n"
            f"[Spatial Metrics Analysis]\n"
            f"- Geometrische Transformation: Tilt {space_metrics['tilt_applied_deg']}°, Pan {space_metrics['pan_applied_deg']}°\n"
            f"- Knotenberechnung: {space_metrics['nodes_count']} Stützstellen prozessiert.\n"
            f"- Vektor-Artefakt: {svg_file.name}"
        )

        doc_path = write_engine.build_document(
            doc_id=doc_id,
            title=rec.subject,
            doc_type=rec.intent_tag,
            author="PhoenixOffice Space & Ingest Engine",
            summary=doc_summary,
            body=rec.body_text
        )

        # 4. Dokument & Metadaten in DB persistieren
        doc_entry = DocumentRecord(
            id=doc_id,
            source_email_id=rec.id,
            title=f"{rec.intent_tag.upper()}: {rec.subject}",
            doc_type=rec.intent_tag,
            storage_path=doc_path,
            metadata_payload={
                "nlp_analysis": analysis,
                "spatial_metrics": space_metrics
