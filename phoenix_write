<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>PhoenixOffice</title>
    <link rel="stylesheet" href="assets/styles.css">
</head>

<body>

<div id="phoenix-office">

    <header>
        <h1>PhoenixOffice – Suite</h1>
    </header>

    <!-- Navigation -->
    <nav id="phoenix-nav">
        <button data-target="dashboard">Dashboard</button>
        <button data-target="write">Write</button>
        <button data-target="mail">Mail</button>
        <button data-target="docs">Docs</button>
        <button data-target="ai">AI</button>
        <button data-target="guard">Guard</button>
        <button data-target="matrix">Matrix</button>
    </nav>

    <!-- Hauptbereich -->
    <main id="phoenix-main">
        <iframe id="phoenix-frame" src="phoenix_dashboard.html"></iframe>
    </main>

</div>

<script type="module">

    const frame = document.getElementById("phoenix-frame");

    const routes = {
        "dashboard": "phoenix_dashboard.html",
        "write": "phoenix_write.html",
        "mail": "phoenix_mail.html",
        "docs": "phoenix_docs.html",
        "ai": "phoenix_ai.html",
        "guard": "phoenix_guard.html",
        "matrix": "phoenix_matrix.html"
    };

    document.querySelectorAll("#phoenix-nav button").forEach(btn => {
        btn.onclick = () => {
            const target = btn.dataset.target;
            frame.src = routes[target];
        };
    });

</script>

</body>
</html>
